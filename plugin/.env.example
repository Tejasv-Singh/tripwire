# Tripwire plugin build-time config (Vite). Copy to `.env.local` (gitignored) and fill in.
# Never put API keys here: everything in a VITE_* variable ends up in the shipped JS bundle.

# Origin of the backend (no trailing slash). The WebSocket URL is derived from it
# (http -> ws, https -> wss, + /ws).
#   Simulator on this PC:  http://127.0.0.1:8000   (the default below; no tunnel needed)
#   Real glasses:          your HTTPS tunnel origin, e.g. https://<your-domain>.ngrok-free.app;
#                          it must also be in app.json's network whitelist (https:// AND wss://)
VITE_BACKEND_URL=http://127.0.0.1:8000

# DEV ONLY: same value as PAIRING_CODE in the repo-root .env, so the simulator connects without
# typing it. Ignored in production builds (`npm run build`); there you enter it on the phone page.
VITE_PAIRING_CODE=
