# Tripwire backend configuration.
# Copy this file to `.env` in the repo root and fill it in. `.env` is gitignored: never commit it.
# Every value is read by backend/src/tripwire/config.py (pydantic-settings).

# Your Hyperliquid TESTNET account (main wallet) public address, 0x… — copy it from app.hyperliquid-testnet.xyz. Empty = HUD shows only the ETH price.
HL_ACCOUNT_ADDRESS=

# WATCH mode: any public TESTNET address to follow read-only while HL_ACCOUNT_ADDRESS is empty (HUD header says WATCH, the action menu is disabled). Find one with: npm run watch:find
WATCH_ADDRESS=

# Private key (64 hex chars) of a Hyperliquid TESTNET *API/agent* wallet — app.hyperliquid-testnet.xyz → API → Generate → Authorize. Never your main wallet key. Empty (or no HL_ACCOUNT_ADDRESS) = trading off; with both set, the glasses can send reduce-only closes behind a two-tap confirm.
HL_AGENT_KEY=

# DRY_RUN=true (default): orders are built and SIGNED like real testnet orders (with HL_AGENT_KEY, or a throwaway key if it's empty), logged to backend/data/dry_run_orders.jsonl, and never sent. Set false (with HL_AGENT_KEY) to really trade on testnet.
DRY_RUN=true

# Telegram bot token from @BotFather (/newbot); then Bot Settings → Mode Settings → Secretary Mode (formerly "Business Mode") → on. Empty = the bot is skipped.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (send /start to the bot: it replies with it). Only this user can use /status, /kill, /unkill, forward order drafts, and receives risk-alert DMs. Empty = nobody.
TELEGRAM_OWNER_ID=

# Liquidation alerts (backend/src/tripwire/risk.py): alert when liquidation is this % or closer to markPx. Change it live with /threshold 8 in Telegram.
ALERT_LIQ_PCT=5
# Re-arm an alert only after the distance is back above ALERT_LIQ_PCT + this (no flapping).
ALERT_HYSTERESIS_PCT=1
# How long "Snooze 5m" on the glasses silences an alert, in seconds.
ALERT_SNOOZE_S=300

# Forwarded-message order drafts (backend/src/tripwire/drafts.py): size and leverage used when the message doesn't say ("BTC long 96.5k sl 95k tp 99k").
DRAFT_DEFAULT_NOTIONAL_USD=100
DRAFT_DEFAULT_LEVERAGE=1

# Policy guard (backend/src/tripwire/policy.py). KILL_SWITCH=true blocks every order that adds exposure (closes and tighter stop-losses still work); /kill in Telegram does the same and survives restarts.
KILL_SWITCH=false
# Max notional (USD) of one opening order.
MAX_OPEN_NOTIONAL_USD=250
# Max leverage of one opening order.
MAX_LEVERAGE=5
# Realized loss (USD, UTC day) that locks opening orders until midnight UTC.
DAILY_LOSS_LIMIT_USD=100

# Anthropic API key from console.anthropic.com → Settings → API Keys. Not used on Day 1.
ANTHROPIC_API_KEY=

# Shared secret the glasses plugin sends as /ws?code=… — any random string of 8+ characters: python -c "import secrets; print(secrets.token_urlsafe(12))"
PAIRING_CODE=

# Hyperliquid REST/WS base URL. MUST stay the testnet URL — the backend refuses to start with anything else.
HL_API_URL=https://api.hyperliquid-testnet.xyz

# Comma-separated browser origins allowed by CORS (the plugin's Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file for bot business-connection records and the intent + order audit logs (relative paths resolve from backend/).
DB_PATH=data/tripwire.sqlite3

# Python log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
